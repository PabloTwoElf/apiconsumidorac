# ==========================================================
# CulturalTrip · Seat API — plantilla de configuración
# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
# .env está en .gitignore: NUNCA subas credenciales al repositorio.
#
# Si arrancas el API desde la raíz del repositorio (Vercel o `node api/index.js`)
# también se lee el .env de la raíz; ver ../.env.example.
# ==========================================================

# ---------- Servidor ----------
PORT=5008
NODE_ENV=development

# URL pública del API. En Vercel se detecta sola (VERCEL_URL); déjala vacía allí.
# PUBLIC_BASE_URL=https://seat-api-tuusuario.vercel.app

# Orígenes permitidos por CORS, separados por coma. Admite comodines
# (https://*.vercel.app) y los subdominios de previsualización de Vercel se
# aceptan solos. Fuera de producción NO hace falta rellenarlo: se acepta
# cualquier puerto de localhost. En producción es obligatorio.
ALLOWED_ORIGINS=

# ---------- Retorno tras el pago ----------
# PayPal devuelve al comprador a /checkout/retorno de este API, y el API lo
# reenvía a la aplicación que inició la compra (el returnUrl de la orden, o el
# origen de quien la creó). Rellénalo solo para forzar un destino fijo.
APP_RETURN_BASE_URL=
APP_RETURN_PATH=/seat-booking

# ---------- Asientos ----------
SEAT_HOLD_TTL_MS=600000      # 10 min que dura un bloqueo temporal
PURGE_INTERVAL_MS=120000     # 2 min entre purgas (solo servidor persistente)
TOTAL_SEATS=40
SEATS_PER_ROW=4

# ---------- Precios ----------
# BASE_PRICE es el precio unitario POR DEFECTO. El consumidor puede enviar
# `precioUnitario` en POST /api/asientos/reservar y en /calcular-precio: queda
# guardado en el hold y es el importe que se cobra en PayPal al crear la orden.
# CulturalTrip envía el precio de su catálogo de rutas (18 USD Guayaquil–Quito).
BASE_PRICE=12.50
PRICE_CURRENCY=USD
MAX_SEATS_PER_BOOKING=10
CORPORATE_DISCOUNT_FROM=5    # Desde aquí se exige razón social y aplica −20 %

# ---------- Pasarela PayPal ----------
# Credenciales de https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_BRAND_NAME=CulturalTrip

# Id del webhook, necesario para verificar la firma de las notificaciones.
# Sin él los webhooks se aceptan SIN verificar: aceptable en sandbox, nunca en producción.
PAYPAL_WEBHOOK_ID=

# Moneda con la que se cobra, y cuántas unidades de PRICE_CURRENCY equivalen a
# una de ella. Con la misma moneda y tasa 1 no hay conversión (caso normal).
PAYMENT_CURRENCY=USD
PAYMENT_FX_RATE=1

# ---------- Administración ----------
# Si se define, las rutas /api/admin exigen la cabecera x-admin-token.
ADMIN_TOKEN=
