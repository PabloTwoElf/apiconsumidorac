# ==========================================================
# CulturalTrip · Seat API — plantilla de configuración
# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
# .env está en .gitignore: NUNCA subas credenciales al repositorio.
# ==========================================================

# ---------- Servidor ----------
PORT=5008
NODE_ENV=development

# URL pública del API. En Vercel se detecta sola (VERCEL_URL); déjala vacía allí.
# PUBLIC_BASE_URL=https://seat-api-tuusuario.vercel.app

# Orígenes permitidos por CORS, separados por coma. Admite comodines
# (https://*.vercel.app) y los subdominios de previsualización de Vercel se
# aceptan solos.
#
# Fuera de producción NO hace falta rellenarlo: se acepta cualquier puerto de
# localhost, para no tener que actualizarlo cada vez que Vite cambia de puerto.
# En producción es obligatorio, o el navegador recibirá 403.
ALLOWED_ORIGINS=

# ---------- Retorno tras el pago ----------
# PayPal devuelve al comprador a /checkout/retorno de este API, y el API lo
# reenvía a la aplicación que inició la compra.
#
# Normalmente esto se deja VACÍO: el destino se deduce del origen de quien creó
# la orden y se guarda en la propia orden, así que funciona con cualquier puerto
# sin configurar nada. Rellénalo solo para forzar un destino fijo.
APP_RETURN_BASE_URL=
APP_RETURN_PATH=/seat-booking

# ---------- Asientos ----------
SEAT_HOLD_TTL_MS=600000      # 10 min que dura un bloqueo temporal
PURGE_INTERVAL_MS=120000     # 2 min entre purgas (solo servidor persistente)
TOTAL_SEATS=40
SEATS_PER_ROW=4

# ---------- Precios ----------
# Moneda del negocio. USD por defecto: es la moneda de Ecuador y la única que
# tiene la cuenta de negocio de PayPal Sandbox. Se admiten decimales.
BASE_PRICE=12.50
PRICE_CURRENCY=USD
MAX_SEATS_PER_BOOKING=10
CORPORATE_DISCOUNT_FROM=5    # Desde aquí se exige razón social y aplica −20 %

# ---------- Pasarela PayPal ----------
# Credenciales de https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_BRAND_NAME=CulturalTrip

# Id del webhook, necesario para verificar la firma de las notificaciones.
# Sin él los webhooks se aceptan SIN verificar: aceptable en sandbox, nunca en producción.
PAYPAL_WEBHOOK_ID=

# Moneda con la que se cobra, y cuántas unidades de PRICE_CURRENCY equivalen a
# una de ella.
#
# Con la misma moneda y tasa 1 no hay conversión: es el caso normal, porque la
# cuenta de negocio de PayPal liquida en USD. Solo hay que cambiarlo si se
# cotiza en una moneda que PayPal no soporta — por ejemplo con PRICE_CURRENCY=COP
# harían falta PAYMENT_CURRENCY=USD y PAYMENT_FX_RATE=4000.
PAYMENT_CURRENCY=USD
PAYMENT_FX_RATE=1
