# ==========================================================================
# apiconsumidorac — plantilla de configuración (frontend + Seat API)
# Copia a .env:  cp .env.example .env     (.env está en .gitignore)
#
# Este mismo archivo lo leen las dos piezas del repositorio:
#   · el frontend Vite (solo las variables con prefijo VITE_, que van EMBEBIDAS
#     en el bundle: nunca pongas aquí un secreto con ese prefijo);
#   · la Seat API cuando se arranca desde la raíz (api/index.js, Vercel) y
#     también desde seat-api/ (env.js carga seat-api/.env y después el .env
#     del directorio actual).
# En Vercel estas variables se definen en Settings → Environment Variables.
# ==========================================================================

# ---------- Frontend ----------
# URL del Seat API. En local VACÍO: el proxy de Vite descubre el puerto solo.
# En producción el API se sirve bajo /api del MISMO dominio, así que también
# puede quedar vacío. Rellénalo solo para apuntar a un API remota desde local.
VITE_SEAT_API_URL=

# ---------- Seat API: servidor ----------
PORT=5008
NODE_ENV=development
# En Vercel se detecta sola (VERCEL_URL); déjala vacía allí.
# PUBLIC_BASE_URL=https://apiconsumidorac.vercel.app

# Orígenes permitidos por CORS, separados por coma (admite https://*.vercel.app).
# Fuera de producción se acepta cualquier puerto de localhost. En producción es
# obligatorio: incluye el frontend principal (CulturalTrip) desplegado en Vercel.
ALLOWED_ORIGINS=https://apiconsumidorac.vercel.app,https://TU-FRONTEND-CULTURALTRIP.vercel.app

# A dónde vuelve el comprador tras pagar si el consumidor no lo indica.
# CulturalTrip envía su propio returnUrl al crear la orden, así que puede quedar vacío.
APP_RETURN_BASE_URL=
APP_RETURN_PATH=/seat-booking

# ---------- Asientos ----------
SEAT_HOLD_TTL_MS=600000
PURGE_INTERVAL_MS=120000
TOTAL_SEATS=40
SEATS_PER_ROW=4

# ---------- Precios ----------
# BASE_PRICE es el precio POR DEFECTO. La aplicación consumidora puede enviar
# `precioUnitario` al bloquear (POST /api/asientos/reservar) y al cotizar: ese
# precio queda guardado en el hold y es el que se cobra en PayPal. CulturalTrip
# envía el precio de cada ruta (p. ej. 18 USD Guayaquil–Quito).
BASE_PRICE=12.50
PRICE_CURRENCY=USD
MAX_SEATS_PER_BOOKING=10
CORPORATE_DISCOUNT_FROM=5

# Moneda de cobro en PayPal y tasa. Con la misma moneda y tasa 1 no hay conversión.
PAYMENT_CURRENCY=USD
PAYMENT_FX_RATE=1

# ---------- PayPal ----------
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_BRAND_NAME=CulturalTrip
# Id del webhook (verificación de firma). Sin él se aceptan sin verificar:
# aceptable en sandbox, nunca en producción.
PAYPAL_WEBHOOK_ID=

# ---------- Administración ----------
# Si se define, /api/admin exige la cabecera x-admin-token. CulturalTrip lo
# envía desde SEAT_API_ADMIN_TOKEN.
ADMIN_TOKEN=
