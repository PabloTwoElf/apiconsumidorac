# ==========================================================
# Frontend de reserva de asientos — plantilla
# Copia a .env:  cp .env.example .env
# .env está en .gitignore.
#
# Solo las variables con prefijo VITE_ llegan al navegador, y van EMBEBIDAS en
# el bundle: nunca pongas aquí un secreto.
# ==========================================================

# URL del Seat API.
#
# En local el API corre en su propio puerto:
VITE_SEAT_API_URL=http://localhost:5008
#
# En producción el API se sirve bajo /api del MISMO dominio que este frontend
# (ver api/index.js y vercel.json), así que basta el dominio a secas:
# VITE_SEAT_API_URL=https://apiconsumidorac.vercel.app
